; *** Metoai installer messages - Bahasa Indonesia (id-id) ***
; Based on the Inno Setup 6 English message set (Default.isl 6.5.0).
; Only the messages shown by Metoai's installer are translated here; all other
; messages fall back to English from Default.isl.
; Do not add a period to messages that don't have one: Inno Setup appends the
; period automatically, so a second one would be displayed.

[LangOptions]
LanguageName=Bahasa Indonesia
LanguageID=$0421
LanguageCodePage=0

[Messages]
SetupAppTitle=Instalasi
SetupWindowTitle=Instalasi - %1
UninstallAppTitle=Hapus Instalasi
UninstallAppFullTitle=Hapus Instalasi %1
InformationTitle=Informasi
ConfirmTitle=Konfirmasi
ErrorTitle=Kesalahan
SetupLdrStartupMessage=Program ini akan menginstal %1. Apakah Anda ingin melanjutkan?
SetupAlreadyRunning=Instalasi sudah berjalan.
WindowsVersionNotSupported=Program ini tidak mendukung versi Windows yang berjalan di komputer Anda.
SetupAppRunningError=Program instalasi mendeteksi bahwa %1 sedang berjalan.%n%nTutup semua instansinya sekarang, lalu klik "OK" untuk melanjutkan, atau "Batal" untuk keluar.
UninstallAppRunningError=Program penghapusan mendeteksi bahwa %1 sedang berjalan.%n%nTutup semua instansinya sekarang, lalu klik "OK" untuk melanjutkan, atau "Batal" untuk keluar.
ExitSetupTitle=Keluar dari Instalasi
ExitSetupMessage=Instalasi belum selesai. Jika Anda keluar sekarang, program tidak akan diinstal.%n%nAnda dapat menjalankan program instalasi lagi nanti untuk menyelesaikan instalasi.%n%nKeluar dari instalasi?
ButtonBack=< &Kembali
ButtonNext=&Berikutnya >
ButtonInstall=&Instal
ButtonOK=OK
ButtonCancel=Batal
ButtonYes=&Ya
ButtonNo=&Tidak
ButtonFinish=&Selesai
ButtonBrowse=&Telusuri...
ButtonWizardBrowse=Tel&usuri...
SelectLanguageTitle=Pilih Bahasa Instalasi
SelectLanguageLabel=Pilih bahasa yang akan digunakan selama instalasi.
ClickNext=Klik "Berikutnya" untuk melanjutkan, atau "Batal" untuk keluar dari instalasi.
WelcomeLabel1=Selamat datang di Panduan Instalasi [name]
WelcomeLabel2=Program ini akan menginstal [name/ver] di komputer Anda.%n%nSebaiknya tutup semua aplikasi lain sebelum melanjutkan.
WizardSelectDir=Pilih Lokasi Tujuan
SelectDirDesc=Di mana [name] harus diinstal?
SelectDirLabel3=Program instalasi akan memasang [name] ke folder berikut.
SelectDirBrowseLabel=Untuk melanjutkan, klik "Berikutnya". Jika Anda ingin memilih folder lain, klik "Telusuri".
DiskSpaceGBLabel=Diperlukan ruang disk kosong minimal [gb] GB.
DiskSpaceMBLabel=Diperlukan ruang disk kosong minimal [mb] MB.
WizardSelectTasks=Pilih Tugas Tambahan
SelectTasksDesc=Tugas tambahan apa yang harus dilakukan?
SelectTasksLabel2=Pilih tugas tambahan yang ingin dilakukan program instalasi saat memasang [name], lalu klik "Berikutnya".
WizardReady=Siap untuk Instalasi
ReadyLabel1=Program instalasi kini siap memasang [name] di komputer Anda.
ReadyLabel2a=Klik "Instal" untuk melanjutkan instalasi, atau klik "Kembali" jika Anda ingin meninjau atau mengubah pengaturan.
ReadyLabel2b=Klik "Instal" untuk melanjutkan instalasi.
ReadyMemoDir=Lokasi tujuan:
ReadyMemoTasks=Tugas tambahan:
WizardPreparing=Mempersiapkan Instalasi
PreparingDesc=Program instalasi sedang mempersiapkan pemasangan [name] di komputer Anda.
CannotContinue=Instalasi tidak dapat dilanjutkan. Klik "Batal" untuk keluar.
ApplicationsFound=Aplikasi berikut sedang menggunakan file yang perlu diperbarui oleh program instalasi. Sebaiknya Anda mengizinkan program instalasi menutup aplikasi tersebut secara otomatis.
ApplicationsFound2=Aplikasi berikut sedang menggunakan file yang perlu diperbarui oleh program instalasi. Sebaiknya Anda mengizinkan program instalasi menutup aplikasi tersebut secara otomatis. Setelah instalasi selesai, program instalasi akan mencoba memulai ulang aplikasi tersebut.
CloseApplications=&Tutup aplikasi secara otomatis
DontCloseApplications=&Jangan tutup aplikasi
WizardInstalling=Menginstal
